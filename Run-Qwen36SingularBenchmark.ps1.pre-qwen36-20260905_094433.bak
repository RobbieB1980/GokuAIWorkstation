[CmdletBinding()]
param([string]$Root='C:\gokuai',[int]$ContextSize=16384,[ValidateSet('4','6','8','8,4','fp8','nvfp4')][string]$CacheQuant='8')
Set-StrictMode -Version Latest;$ErrorActionPreference='Stop'
$target=Join-Path $Root 'models\Qwen3.6-27B-exl3-4bpw';$draft=Join-Path $Root 'models\Qwen3.6-27B-DFlash-exl3-4bpw';$envFile=Join-Path $Root 'runtime\mia-kit\.env';$py=Join-Path $Root 'runtime\mia-kit\.venv\Scripts\python.exe';$reset=Join-Path $Root 'Reset-GokuBackend.ps1';$start=Join-Path $Root 'Start-GokuBackend.ps1';$index=Join-Path $Root 'DataIndex\goku-data.db'
foreach($p in @($target,$draft,$envFile,$py,$index)){if(-not(Test-Path $p)){throw "Missing: $p"}}
$stamp=Get-Date -Format 'yyyyMMdd_HHmmss';$dir=Join-Path $Root "benchmarks\qwen36-singular-$stamp";New-Item $dir -ItemType Directory -Force|Out-Null;$s2=Join-Path $dir 'stage2-qwen36-dflash.json';$s3=Join-Path $dir 'stage3-qwen36-dflash.json';$summary=Join-Path $dir 'comparison-summary.json';$saved=[IO.File]::ReadAllText($envFile);$utf8=New-Object Text.UTF8Encoding $false
function Set-Key($lines,$key,$value){$found=$false;$o=foreach($line in $lines){if($line-match ('^\s*'+[regex]::Escape($key)+'\s*=')){$found=$true;"$key=$value"}else{$line}};if(-not$found){$o+="$key=$value"};,@($o)}
try{&$reset -Root $Root -TargetUsedMiB 2500 -MaxWaitSeconds 120;$l=Get-Content $envFile;$l=Set-Key $l MODEL_DIR ($target-replace'\\','/');$l=Set-Key $l DRAFT dflash2;$l=Set-Key $l DRAFT_DIR ($draft-replace'\\','/');$l=Set-Key $l CONTEXT_SIZE "$ContextSize";$l=Set-Key $l CACHE_QUANT $CacheQuant;[IO.File]::WriteAllLines($envFile,$l,$utf8);&$start -Root $Root -ForceRestart
&$py (Join-Path $Root 'scripts\benchmark_stage2.py') --output $s2 --report-as qwen36_27b_dflash --worker-label 'Qwen3.6-27B EXL3 4bpw + DFlash';if($LASTEXITCODE-ne0){throw "Stage 2 exit $LASTEXITCODE"}
&$py (Join-Path $Root 'scripts\benchmark_stage3.py') --index $index --output $s3 --report-as qwen36_27b_dflash --worker-label 'Qwen3.6-27B EXL3 4bpw + DFlash';if($LASTEXITCODE-ne0){throw "Stage 3 exit $LASTEXITCODE"}
$a=Get-Content $s2 -Raw|ConvertFrom-Json;$b=Get-Content $s3 -Raw|ConvertFrom-Json;$m=$a.models.qwen36_27b_dflash;[ordered]@{schema='qwen36-singular-comparison-v1';created=(Get-Date).ToString('o');model='Qwen3.6-27B EXL3 4bpw + DFlash';stage2=[ordered]@{quality=$m.quality_score;success=$m.success_rate;mean_seconds=$m.mean_seconds};stage3=[ordered]@{production=$b.modes.production;oracle=$b.modes.oracle};files=[ordered]@{stage2=$s2;stage3=$s3}}|ConvertTo-Json -Depth 10|Set-Content $summary -Encoding UTF8
Write-Host "Singular benchmark complete: $summary" -ForegroundColor Green}finally{&$reset -Root $Root -TargetUsedMiB 2500 -MaxWaitSeconds 120;[IO.File]::WriteAllText($envFile,$saved,$utf8)}
